import React, { useState } from 'react';
import {
  StyleSheet,
  Text,
  View,
  TextInput,
  TouchableOpacity,
  SafeAreaView,
  StatusBar,
  ScrollView,
  Alert,
} from 'react-native';

export default function App() {
  const [isLoggedIn, setIsLoggedIn] = useState(false);
  const [authMethod, setAuthMethod] = useState('phone');
  const [countryCode, setCountryCode] = useState('+93');
  const [inputValue, setInputValue] = useState('');
  const [otpCode, setOtpCode] = useState('');
  const [step, setStep] = useState(1);
  const [currentTab, setCurrentTab] = useState('home');

  // مدیریت پیشرفته محتوا و مدیا (عکس، ویدیو، استیکر، گیف)
  const [adTitle, setAdTitle] = useState('');
  const [adPrice, setAdPrice] = useState('');
  const [mediaType, setMediaType] = useState('photo'); // photo, video, gif, sticker

  const categories = [
    { id: '1', title: 'سوپرمارکت و مواد غذایی', icon: '🛒' },
    { id: '2', title: 'پوشاک و مد', icon: '👕' },
    { id: '3', title: 'لوازم دیجیتال و برقی', icon: '📱' },
    { id: '4', title: 'خودرو و قطعات', icon: '🚗' },
    { id: '5', title: 'املاک تجاری و مسکونی', icon: '🏠' },
  ];

  const [products, setProducts] = useState([
    { id: '101', title: 'تخفیف ویژه سوپرمارکت مرکزی', price: '$15', category: 'سوپرمارکت', type: '📸 عکس ثبت شده' },
    { id: '102', title: 'ویدیو معرفی محصولات تازه', price: '$120', category: 'سوپرمارکت', type: '🎥 ویدیو HD' },
  ]);

  const handleSendOTP = () => {
    if (!inputValue) {
      Alert.alert('خطای امنیتی', 'لطفاً شماره معتبر برای دریافت کد امنیتی وارد کنید.');
      return;
    }
    setStep(2);
  };

  const handleVerifyOTP = () => {
    if (!otpCode || otpCode.length < 6) {
      Alert.alert('خطای احراز هویت', 'کد امنیتی ۶ رقمی اشتباه است.');
      return;
    }
    setIsLoggedIn(true);
  };

  const handleCreateAdvancedAd = () => {
    if (!adTitle || !adPrice) {
      Alert.alert('خطا', 'لطفاً عنوان و قیمت را به طور کامل وارد کنید.');
      return;
    }
    const newProduct = {
      id: Date.now().toString(),
      title: adTitle,
      price: `$${adPrice}`,
      category: 'سوپرمارکت / تازه',
      type: mediaType === 'video' ? '🎥 ویدیو' : mediaType === 'gif' ? '🎞️ گیف' : '📸 عکس دوربین',
    };
    setProducts([newProduct, ...products]);
    Alert.alert('تایید مالکیت', 'محتوا با امنیت کامل و بدون تبلیغات مزاحم منتشر شد!');
    setAdTitle('');
    setAdPrice('');
    setCurrentTab('home');
  };

  if (isLoggedIn) {
    return (
      <SafeAreaView style={styles.container}>
        <StatusBar barStyle="light-content" />
        
        <View style={styles.header}>
          <Text style={styles.logoText}>Blackstarszone (امنیت کامل)</Text>
          <TouchableOpacity onPress={() => setIsLoggedIn(false)}>
            <Text style={styles.logoutText}>قفل امنیتی / خروج</Text>
          </TouchableOpacity>
        </View>

        <View style={{ flex: 1 }}>
          {currentTab === 'home' && (
            <ScrollView contentContainerStyle={{ padding: 15 }}>
              <TextInput
                style={styles.searchInput}
                placeholder="جستجوی هوشمند کالا، سوپرمارکت، ویدیو..."
                placeholderTextColor="#64748b"
              />

              <View style={styles.secureBanner}>
                <Text style={styles.secureBannerText}>🛡️ سیستم ضد هک و بدون تبلیغات فعال است (تایید مالک)</Text>
              </View>

              <Text style={styles.sectionTitle}>دسته‌بندی‌های بازار فوق‌پیشرفته</Text>
              <ScrollView horizontal showsHorizontalScrollIndicator={false} style={{ marginBottom: 20 }}>
                {categories.map((item) => (
                  <View key={item.id} style={styles.categoryCard}>
                    <Text style={{ fontSize: 24 }}>{item.icon}</Text>
                    <Text style={styles.categoryText}>{item.title}</Text>
                  </View>
                ))}
              </ScrollView>

              <Text style={styles.sectionTitle}>فید تصویری و ویدیویی سوپرمارکت‌ها</Text>
              {products.map((item) => (
                <View key={item.id} style={styles.productCard}>
                  <View>
                    <Text style={styles.productTitle}>{item.title}</Text>
                    <Text style={styles.mediaBadge}>{item.type}</Text>
                  </View>
                  <Text style={styles.productPrice}>{item.price}</Text>
                </View>
              ))}
            </ScrollView>
          )}

          {currentTab === 'add' && (
            <ScrollView contentContainerStyle={{ padding: 20 }}>
              <Text style={[styles.sectionTitle, { fontSize: 20, textAlign: 'center' }]}>دوربین و ثبت رسانه (سوپرمارکت)</Text>
              
              <Text style={styles.fieldLabel}>انتخاب نوع رسانه:</Text>
              <View style={styles.tabContainer}>
                <TouchableOpacity style={[styles.mediaTab, mediaType === 'photo' && styles.activeMedia]} onPress={() => setMediaType('photo')}>
                  <Text style={styles.tabText}>📸 عکس</Text>
                </TouchableOpacity>
                <TouchableOpacity style={[styles.mediaTab, mediaType === 'video' && styles.activeMedia]} onPress={() => setMediaType('video')}>
                  <Text style={styles.tabText}>🎥 ویدیو</Text>
                </TouchableOpacity>
                <TouchableOpacity style={[styles.mediaTab, mediaType === 'gif' && styles.activeMedia]} onPress={() => setMediaType('gif')}>
                  <Text style={styles.tabText}>🎞️ گیف</Text>
                </TouchableOpacity>
              </View>

              <Text style={styles.fieldLabel}>عنوان محصول یا سوپرمارکت:</Text>
              <TextInput
                style={styles.searchInput}
                placeholder="مثلاً: تخفیف ویژه نوشیدنی و مواد غذایی"
                placeholderTextColor="#64748b"
                value={adTitle}
                onChangeText={setAdTitle}
              />

              <Text style={styles.fieldLabel}>قیمت (دلار):</Text>
              <TextInput
                style={styles.searchInput}
                placeholder="مثلاً: 10"
                placeholderTextColor="#64748b"
                keyboardType="numeric"
                value={adPrice}
                onChangeText={setAdPrice}
              />

              <TouchableOpacity style={styles.button} onPress={handleCreateAdvancedAd}>
                <Text style={styles.buttonText}>ثبت و انتشار امن (بدون تبلیغات)</Text>
              </TouchableOpacity>
            </ScrollView>
          )}

          {currentTab === 'profile' && (
            <View style={{ flex: 1, justifyContent: 'center', alignItems: 'center', padding: 20 }}>
              <Text style={{ color: '#fff', fontSize: 18, fontWeight: 'bold' }}>مدیریت کامل حساب مالک</Text>
              <Text style={{ color: '#38bdf8', marginTop: 10 }}>وضعیت امنیتی: کاملاً رمزنگاری شده</Text>
              <Text style={{ color: '#94a3b8', marginTop: 5 }}>بدون نمایش هیچ‌گونه تبلیغات شخص ثالث</Text>
            </View>
          )}
        </View>

        <View style={styles.bottomNav}>
          <TouchableOpacity onPress={() => setCurrentTab('home')} style={styles.navItem}>
            <Text style={{ fontSize: 20 }}>🏠</Text>
            <Text style={[styles.navText, currentTab === 'home' && styles.activeNavText]}>فید بازار</Text>
          </TouchableOpacity>

          <TouchableOpacity onPress={() => setCurrentTab('add')} style={styles.navItem}>
            <Text style={{ fontSize: 20 }}>📷</Text>
            <Text style={[styles.navText, currentTab === 'add' && styles.activeNavText]}>دوربین/رسانه</Text>
          </TouchableOpacity>

          <TouchableOpacity onPress={() => setCurrentTab('profile')} style={styles.navItem}>
            <Text style={{ fontSize: 20 }}>🔒</Text>
            <Text style={[styles.navText, currentTab === 'profile' && styles.activeNavText]}>مدیریت من</Text>
          </TouchableOpacity>
        </View>
      </SafeAreaView>
    );
  }

  return (
    <SafeAreaView style={styles.container}>
      <StatusBar barStyle="light-content" />
      <ScrollView contentContainerStyle={styles.scrollContainer}>
        <View style={styles.card}>
          <Text style={styles.title}>Blackstarszone</Text>
          <Text style={styles.subtitle}>ورود امن اختصاصی (حفاظت در برابر نفوذ)</Text>

          {step === 1 ? (
            <>
              <View style={styles.inputContainer}>
                <Text style={styles.countryPrefix}>{countryCode}</Text>
                <TextInput
                  style={styles.input}
                  placeholder="شماره تماس (مثلاً 799123456)"
                  placeholderTextColor="#64748b"
                  keyboardType="phone-pad"
                  value={inputValue}
                  onChangeText={setInputValue}
                />
              </View>

              <TouchableOpacity style={styles.button} onPress={handleSendOTP}>
                <Text style={styles.buttonText}>دریافت کد تایید امنیتی</Text>
              </TouchableOpacity>
            </>
          ) : (
            <>
              <Text style={styles.otpNotice}>کد تایید امنیتی ارسال شده را وارد کنید:</Text>
              <TextInput
                style={[styles.input, styles.otpInput]}
                placeholder="------"
                placeholderTextColor="#64748b"
                keyboardType="number-pad"
                maxLength={6}
                value={otpCode}
                onChangeText={setOtpCode}
              />
              <TouchableOpacity style={styles.button} onPress={handleVerifyOTP}>
                <Text style={styles.buttonText}>تایید و ورود به اپلیکیشن</Text>
              </TouchableOpacity>
            </>
          )}
        </View>
      </ScrollView>
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, backgroundColor: '#070f1e' },
  scrollContainer: { flexGrow: 1, justifyContent: 'center', alignItems: 'center', padding: 20 },
  card: { width: '100%', maxWidth: 400, backgroundColor: '#111c30', padding: 24, borderRadius: 20, borderWidth: 1, borderColor: '#1e3a8a' },
  title: { fontSize: 26, fontWeight: 'bold', color: '#38bdf8', textAlign: 'center' },
  subtitle: { fontSize: 13, color: '#94a3b8', textAlign: 'center', marginBottom: 20, marginTop: 4 },
  secureBanner: { backgroundColor: '#064e3b', padding: 10, borderRadius: 8, marginBottom: 15, borderWidth: 1, borderColor: '#059669' },
  secureBannerText: { color: '#34d399', fontSize: 12, textAlign: 'center', fontWeight: 'bold' },
  tabContainer: { flexDirection: 'row', backgroundColor: '#070f1e', borderRadius: 10, padding: 4, marginBottom: 15 },
  mediaTab: { flex: 1, paddingVertical: 10, alignItems: 'center', borderRadius: 8 },
  activeMedia: { backgroundColor: '#2563eb' },
  inputContainer: { flexDirection: 'row', alignItems: 'center', backgroundColor: '#070f1e', borderRadius: 10, borderWidth: 1, borderColor: '#1e3a8a', marginBottom: 20, paddingHorizontal: 12 },
  countryPrefix: { color: '#38bdf8', fontWeight: 'bold', marginRight: 8 },
  input: { flex: 1, color: '#ffffff', paddingVertical: 12, fontSize: 16, textAlign: 'right' },
  otpInput: { textAlign: 'center', letterSpacing: 8, fontSize: 22 },
  button: { backgroundColor: '#2563eb', paddingVertical: 14, borderRadius: 10, alignItems: 'center', marginTop: 10 },
  buttonText: { color: '#ffffff', fontWeight: 'bold', fontSize: 16 },
  otpNotice: { color: '#94a3b8', textAlign: 'center', marginBottom: 15, fontSize: 13 },
  header: { flexDirection: 'row-reverse', justifyContent: 'space-between', alignItems: 'center', padding: 15, backgroundColor: '#111c30', borderBottomWidth: 1, borderColor: '#1e3a8a' },
  logoText: { color: '#38bdf8', fontSize: 16, fontWeight: 'bold' },
  logoutText: { color: '#ef4444', fontSize: 12 },
  searchInput: { backgroundColor: '#111c30', color: '#fff', padding: 12, borderRadius: 10, marginBottom: 15, textAlign: 'right', borderWidth: 1, borderColor: '#1e3a8a' },
  sectionTitle: { color: '#fff', fontSize: 15, fontWeight: 'bold', marginBottom: 10, textAlign: 'right' },
  fieldLabel: { color: '#94a3b8', fontSize: 13, marginBottom: 5, textAlign: 'right' },
  categoryCard: { backgroundColor: '#111c30', padding: 15, borderRadius: 12, alignItems: 'center', marginLeft: 10, width: 100, borderWidth: 1, borderColor: '#1e3a8a' },
  categoryText: { color: '#94a3b8', fontSize: 11, marginTop: 5, textAlign: 'center' },
  productCard: { backgroundColor: '#111c30', padding: 15, borderRadius: 12, flexDirection: 'row-reverse', justifyContent: 'space-between', alignItems: 'center', marginBottom: 10, borderWidth: 1, borderColor: '#1e3a8a' },
  productTitle: { color: '#fff', fontWeight: 'bold', fontSize: 14 },
  mediaBadge: { color: '#38bdf8', fontSize: 11, marginTop: 3 },
  productPrice: { color: '#34d399', fontWeight: 'bold', fontSize: 15 },
  bottomNav: { flexDirection: 'row-reverse', justifyContent: 'space-around', backgroundColor: '#111c30', paddingVertical: 10, borderTopWidth: 1, borderColor: '#1e3a8a' },
  navItem: { alignItems: 'center' },
  navText: { color: '#64748b', fontSize: 11, marginTop: 2 },
  activeNavText: { color: '#38bdf8', fontWeight: 'bold' },
});
